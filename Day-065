Day 65 - Delete the Middle Node of a Linked List

Problem Statement:
Given the head of a linked list, delete the middle node and return the head of the modified linked list.

The middle node is defined as the node at index ⌊n/2⌋ using 0-based indexing.

Code

/**
 * Definition for singly-linked list.
 * struct ListNode {
 *     int val;
 *     ListNode *next;
 *     ListNode() : val(0), next(nullptr) {}
 *     ListNode(int x) : val(x), next(nullptr) {}
 *     ListNode(int x, ListNode *next) : val(x), next(next) {}
 * };
 */


class Solution {
public:
    ListNode* deleteMiddle(ListNode* head) {


        if (head == NULL || head->next == NULL)
            return NULL;


        ListNode* slow = head;
        ListNode* fast = head;
        ListNode* prev = NULL;


        while (fast != NULL && fast->next != NULL) {
            prev = slow;
            slow = slow->next;
            fast = fast->next->next;
        }


        prev->next = slow->next;
        delete slow;


        return head;
    }
};

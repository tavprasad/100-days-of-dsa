Day 74 - Next Greater Element II

Problem Statement:
Given a circular integer array nums, return the next greater element for every element. If no greater element exists, return -1.

Code:

class Solution {
public:
    vector<int> nextGreaterElements(vector<int>& nums) {
        int n = nums.size();
        vector<int> ans(n);
        stack<int> s;

        for(int i = 2 * n - 1; i >= 0; i--) {

            while(!s.empty() && s.top() <= nums[i % n]) {
                s.pop();
            }

            if(s.empty()) {
                ans[i % n] = -1;
            }
            else {
                ans[i % n] = s.top();
            }

            s.push(nums[i % n]);
        }

        return ans;
    }
};

